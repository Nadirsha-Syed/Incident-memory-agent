# Incident Memory Agent - Environment Configuration

# Server Port
PORT=5000

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:3000

# MongoDB Connection String (MongoDB Atlas or local URI)
# If left empty or invalid, the backend automatically initializes an in-memory MongoDB instance for seamless local demoing
MONGODB_URI=

# Groq API Configuration
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=
# Models supported: llama-3.3-70b-versatile, openai/gpt-oss-120b, qwen/qwen3-32b
GROQ_MODEL=llama-3.3-70b-versatile

# Hindsight Persistent Memory Configuration (Vectorize.io)
# Hindsight Cloud: https://api.hindsight.vectorize.io
# Self-hosted instance: http://localhost:8888
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=incident-memory-agent-prod
