# Incident Memory Agent - Server Environment Configuration

PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB Connection String (MongoDB Atlas or local URI)
# If left empty, the backend automatically initializes an in-memory MongoDB instance for local demonstration
MONGODB_URI=

# Groq API Configuration
# Get your API key at: https://console.groq.com/keys
# Supported models: llama-3.3-70b-versatile, openai/gpt-oss-120b, qwen/qwen3-32b
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Hindsight Persistent Memory Configuration (Vectorize.io)
# Hindsight Cloud: https://api.hindsight.vectorize.io
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=incident-memory-agent-prod
